{
  "name": "@upsolve/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "check:store": "node --env-file=.env scripts/check-store.ts",
    "seed:sheets": "node --env-file=.env scripts/seed-sheets.ts",
    "sheets:extract": "node scripts/extract-tuf-sheet.mjs strivers-a2z-dsa-sheet striver-a2z && node scripts/extract-tuf-sheet.mjs strivers-sde-sheet striver-sde && node scripts/extract-neetcode-sheets.mjs"
  },
  "dependencies": {
    "@upsolve/adapters": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
