# Copy to .env.local and fill in. Without these the app runs in demo mode (no auth).
# Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Supabase → Connect → Connection string → URI.
# Local dev: Session pooler (port 5432). Vercel/serverless: Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Connections per server instance (default 5). On Vercel set 1: every function instance
# opens its own pool, and the transaction pooler shares them.
# DATABASE_POOL_MAX=1
# Keep the Supabase project and Vercel's functions in one region (vercel.json: bom1, Mumbai).

# Weekly email (optional). Without RESEND_API_KEY the cron route only does a dry run.
# CRON_SECRET also signs unsubscribe links; any long random string (openssl rand -base64 32).
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM="DsaKaro <weekly@your-domain.com>"

# Emails (comma-separated) that can read beta feedback at /dashboard/feedback.
ADMIN_EMAILS=

# Public URL of the site (link previews, share cards), e.g. https://dsakaro.in
NEXT_PUBLIC_SITE_URL=
